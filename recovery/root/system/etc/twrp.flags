# TWRP Configuration Flags for MT6878 (lj7_h782)
# Mount point fstype device flags

Boot & Critical Partitions
/preloader emmc /dev/block/by-name/preloader_a flags=display="Preloader";backup=1;flashimg=1;slotselect
/lk emmc /dev/block/by-name/lk_a flags=display="LK";backup=1;flashimg=1;slotselect
/boot emmc /dev/block/by-name/boot_a flags=display="Boot";backup=1;flashimg=1;slotselect
/vendor_boot emmc /dev/block/by-name/vendor_boot_a flags=display="Vendor Boot";backup=1;flashimg=1;slotselect
/init_boot emmc /dev/block/by-name/init_boot_a flags=display="Init Boot";backup=1;flashimg=1;slotselect
/dtbo emmc /dev/block/by-name/dtbo_a flags=display="DTBO";backup=1;flashimg=1;slotselect

TrustZone & Security
/tee emmc /dev/block/by-name/tee_a flags=display="TEE";backup=1;flashimg=1;slotselect
/tkv emmc /dev/block/by-name/tkv_a flags=display="TKV";backup=1;flashimg=1;slotselect

VBmeta & Verification
/vbmeta emmc /dev/block/by-name/vbmeta_a flags=display="VBMeta";backup=1;flashimg=1;slotselect
/vbmeta_system emmc /dev/block/by-name/vbmeta_system_a flags=display="VBMeta System";backup=1;flashimg=1;slotselect
/vbmeta_vendor emmc /dev/block/by-name/vbmeta_vendor_a flags=display="VBMeta Vendor";backup=1;flashimg=1;slotselect

